# Normalize line endings so the extension's JS and the Python sources don't
# churn between checkouts on different platforms.
* text=auto eol=lf

# Binary assets: never diff or line-ending-convert these.
*.png  binary
*.jpg  binary
*.ico  binary
*.pdf  binary
*.pptx binary
*.docx binary
*.joblib binary
*.onnx binary
*.parquet binary

# Keep generated/vendored files out of language statistics and diffs.
extension/package-lock.json linguist-generated=true -diff
notebooks/*.ipynb linguist-documentation=true
