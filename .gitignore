# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---
venv/
.venv/
env/

# --- Testing / coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Serialized models (Iron Law #5) ---
models/*.pkl
models/*.joblib
models/*.onnx
models/**/*.pkl
models/**/*.joblib
models/**/*.onnx
models/**/*.json
models/latest/

# --- Model reports (plots/JSON are fine to commit; the access log is a
# local dev audit trail, not meaningful history) ---
reports/.test_set_access_log.json

# --- Secrets / config ---
.env
*.env

# --- Auth/vault database (Phase 8) — local dev data, never commit ---
*.db
*.db-journal

# --- Local Redis persistence (Phase 2, G2/G1 dev use) ---
dump.rdb

# --- Caches ---
/tmp/tldextract_cache/
.tldextract_cache/

# --- Data files (raw downloads and processed splits — never commit large datasets) ---
data/raw/*.csv
data/raw/*.arff
data/raw/feeds/*.csv
data/raw/feeds/active_snapshot.txt
data/processed/*.parquet
data/processed/*.csv
data/processed/*.json
# Keep gitkeep markers:
!data/raw/.gitkeep
!data/processed/.gitkeep

# --- Jupyter ---
.ipynb_checkpoints/

# --- OS / editor ---
.DS_Store
.idea/
.vscode/

# --- Editor / assistant tooling (machine-local settings, never shared) ---
.claude/

# --- Linter cache ---
# ruff writes .ruff_cache/.gitignore containing "*", so this already
# self-ignores; listed explicitly rather than relying on the tool to keep
# policing itself.
.ruff_cache/

# --- Browser extension (Node tooling for tests only; MV3 needs no build step) ---
extension/node_modules/

# --- Kept local, deliberately NOT published to the public repository ---
# Working notes, the written report, and generated model reports. Nothing in
# src/ or tests/ reads any of these at runtime -- they are referenced only in
# docstrings and comments -- and scripts/evaluate.py recreates reports/ via
# mkdir(parents=True, exist_ok=True), so a fresh clone still builds and tests
# clean without them.
#
# docs/ is excluded wholesale EXCEPT the two things a public reader needs: the
# endpoint reference and the figures the README embeds. Note the pattern must
# be `docs/*`, not `docs/` -- git does not descend into an ignored *directory*,
# so a `!docs/images/` negation under `docs/` would never be evaluated.
docs/*
!docs/API.md
!docs/images/
Report/
reports/
CLAUDE.md
ARGUS_FEATURE_EXPANSION_ROADMAP.md

# --- Presentation + viva material: local submission artefacts, not code ---
# Kept out of the repo so a stray `git add -A` cannot commit ~3 MB of slide
# decks and speaking notes (which is exactly what happened once).
/*.pdf
/*.pptx
/*.docx
