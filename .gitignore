# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---
venv/
.venv/
env/

# --- Testing / coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Serialized models (Iron Law #5) ---
models/*.pkl
models/*.joblib
models/*.onnx
models/**/*.pkl
models/**/*.joblib
models/**/*.onnx
models/**/*.json
models/latest/

# --- Model reports (plots/JSON are fine to commit; the access log is a
# local dev audit trail, not meaningful history) ---
reports/.test_set_access_log.json

# --- Secrets / config ---
.env
*.env

# --- Auth/vault database (Phase 8) — local dev data, never commit ---
*.db
*.db-journal

# --- Local Redis persistence (Phase 2, G2/G1 dev use) ---
dump.rdb

# --- Caches ---
/tmp/tldextract_cache/
.tldextract_cache/

# --- Data files (raw downloads and processed splits — never commit large datasets) ---
data/raw/*.csv
data/raw/*.arff
data/raw/feeds/*.csv
data/raw/feeds/active_snapshot.txt
data/processed/*.parquet
data/processed/*.csv
data/processed/*.json
# Keep gitkeep markers:
!data/raw/.gitkeep
!data/processed/.gitkeep

# --- Jupyter ---
.ipynb_checkpoints/

# --- OS / editor ---
.DS_Store
.idea/
.vscode/

# --- Browser extension (Node tooling for tests only; MV3 needs no build step) ---
extension/node_modules/
